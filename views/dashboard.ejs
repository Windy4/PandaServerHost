<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard · PandaServerHost</title>
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
  <%- include('partials/topbar', { user }) %>
  <div class="container grid">
    <div id="msg"></div>

    <div class="card">
      <h3>Request a Minecraft server</h3>
      <p class="muted">Submit a request. An admin must approve it before the server is deployed.</p>
      <form id="requestForm">
        <div class="row">
          <div><label>Server name</label><input name="name" placeholder="My SMP" required /></div>
          <div>
            <label>Type</label>
            <select name="server_type">
              <option>PAPER</option><option>FABRIC</option><option>VANILLA</option><option>FORGE</option>
            </select>
          </div>
          <div><label>MC version</label><input name="mc_version" value="LATEST" /></div>
        </div>
        <div class="row">
          <div><label>RAM (MB)</label><input name="ram_mb" type="number" value="2048" min="512" /></div>
          <div><label>CPU cores</label><input name="cpu_cores" type="number" step="0.5" value="1" min="0.5" /></div>
          <div><label>Disk (MB)</label><input name="disk_mb" type="number" value="5120" min="512" /></div>
        </div>
        <label>Note to admin (optional)</label>
        <textarea name="note" placeholder="What's this server for?"></textarea>
        <div style="margin-top:12px"><button class="primary" type="submit">Submit request</button></div>
      </form>
    </div>

    <div class="split">
      <div class="card">
        <h3>My servers</h3>
        <table><tbody id="serversTable"><tr><td class="muted">Loading…</td></tr></tbody></table>
      </div>
      <div class="card">
        <h3>My requests</h3>
        <table><tbody id="requestsTable"><tr><td class="muted">Loading…</td></tr></tbody></table>
      </div>
    </div>
  </div>
  <script src="/static/js/common.js"></script>
  <script src="/static/js/dashboard.js"></script>
</body>
</html>
