# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# HTTP port the control-panel web server listens on (NOT a Minecraft port).
PORT=8080

# Bind address. Use 127.0.0.1 if you put a reverse proxy (nginx/caddy) in front.
HOST=0.0.0.0

# Secret used to sign JWT auth tokens. MUST be long & random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid.
JWT_EXPIRES_IN=7d

# Set to "true" only when serving over HTTPS (marks the auth cookie Secure).
SECURE_COOKIES=false

# Range of host ports that may be assigned to Minecraft servers.
# You port-forward these on your router manually.
MC_PORT_MIN=25565
MC_PORT_MAX=25600

# Docker image used to run each Minecraft server.
MC_IMAGE=itzg/minecraft-server:latest

# Absolute path on the host where per-server data volumes are stored.
# Leave blank to use ./servers relative to the project.
SERVERS_DIR=

# Hard ceiling an admin can grant for a single server (safety cap).
MAX_RAM_MB=8192
MAX_CPU_CORES=4
MAX_DISK_MB=20480
